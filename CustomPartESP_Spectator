-- ==========================================
local function getRelativeDirectionInfo(targetPos)
	local camCF = Camera.CFrame
	local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
	local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
	local offset = targetPos - camCF.Position
	local flatOffset = Vector3.new(offset.X, 0, offset.Z)

	if flatOffset.Magnitude < 2 then
		return "🎯 Tepat", "🎯"
	end

	flatLook = flatLook.Unit
	flatRight = flatRight.Unit
	flatOffset = flatOffset.Unit

	local forwardDot = flatLook:Dot(flatOffset)
	local rightDot = flatRight:Dot(flatOffset)
	local angle = math.deg(math.atan2(rightDot, forwardDot))

	local vertHint = ""
	if offset.Y > 8 then
		vertHint = "↑"
	elseif offset.Y < -8 then
		vertHint = "↓"
	end

	if angle >= -22.5 and angle <= 22.5 then
		return "⬆️ Depan" .. vertHint, "⬆️"
	elseif angle > 22.5 and angle <= 67.5 then
		return "↗️ Kanan-Dpn" .. vertHint, "↗️"
	elseif angle > 67.5 and angle <= 112.5 then
		return "➡️ Kanan" .. vertHint, "➡️"
	elseif angle > 112.5 and angle <= 157.5 then
		return "↘️ Kanan-Blk" .. vertHint, "↘️"
	elseif angle < -22.5 and angle >= -67.5 then
		return "↖️ Kiri-Dpn" .. vertHint, "↖️"
	elseif angle < -67.5 and angle >= -112.5 then
		return "⬅️ Kiri" .. vertHint, "⬅️"
	elseif angle < -112.5 and angle >= -157.5 then
		return "↙️ Kiri-Blk" .. vertHint, "↙️"
	else
		return "⬇️ Belakang" .. vertHint, "⬇️"
	end
end

