end)

table.insert(connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not isPickingTarget then return end
	if input.KeyCode == Enum.KeyCode.Escape then
		stopPickMode()
		return
	end
	if gameProcessed then return end

	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local resolvedObj, rawPart, hitPlayer = getMouseWorldTarget()
		if resolvedObj then
			if hitPlayer then
				targetMatchMode = "Player"
				targetKeyword = hitPlayer.Name
				selectedPlayer = hitPlayer
				lastEspPlayer = hitPlayer
				dropdownBtn.Text = "Target: " .. hitPlayer.DisplayName .. " ▼"
				statusLabel.Text = "Target Player: @" .. hitPlayer.Name .. " (Siap Pin/Spectate)"
			else
				local rawNameLower = resolvedObj.Name:lower()
				if genericPartNames[rawNameLower] then
					if rawPart and rawPart:IsA("MeshPart") and rawPart.MeshId ~= "" then
						targetMatchMode = "MeshId"
						targetMeshId = rawPart.MeshId
						targetKeyword = resolvedObj.Name .. " (Mesh)"
					else
						targetMatchMode = "Size"
						targetRefSize = rawPart and rawPart.Size or Vector3.new(1, 1, 1)
						targetKeyword = resolvedObj.Name .. " (Ukuran)"
					end
				else
					targetMatchMode = "Name"
					targetKeyword = extractCleanKeyword(resolvedObj.Name)
				end
			end

			targetNameInput.Text = targetKeyword
			stopPickMode()
			rescanWorkspace()
		end
	end
end))

