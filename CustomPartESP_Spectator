local function getMouseWorldTarget()
	local mousePos = UserInputService:GetMouseLocation()
	local unitRay = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local ignoreList = {waypointFolder}
	if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
	rayParams.FilterDescendantsInstances = ignoreList

	local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, rayParams)
	if result and result.Instance then
		local resolvedObj, hitPlayer = resolveClickedObject(result.Instance)
		return resolvedObj, result.Instance, hitPlayer
	end
	return nil, nil, nil
end

local function stopPickMode()
	isPickingTarget = false
	hoverHighlight.Enabled = false
	hoverHighlight.Adornee = nil
	pickTargetBtn.Text = "🎯 Set Target (Klik Benda / Player)"
	pickTargetBtn.BackgroundColor3 = Color3.fromRGB(210, 120, 20)
end

