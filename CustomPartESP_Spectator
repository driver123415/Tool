	if wpData.lineFrame then wpData.lineFrame:Destroy() end
	if wpData.rowFrame then wpData.rowFrame:Destroy() end

	for i, item in ipairs(waypoints) do
		if item == wpData then
			table.remove(waypoints, i)
			break
		end
	end
	updateWaypointCanvasSize()
end

local function clearAllWaypoints()
	for i = #waypoints, 1, -1 do
		local wp = waypoints[i]
		if wp.markerPart then wp.markerPart:Destroy() end
		if wp.lineFrame then wp.lineFrame:Destroy() end
		if wp.rowFrame then wp.rowFrame:Destroy() end
	end
	table.clear(waypoints)
	updateWaypointCanvasSize()
end

