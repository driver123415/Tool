local function setCharacterLocalTransparency(char, val)
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = val
		end
	end
end

local function resetToOwnCamera()
	if selectedPlayer and selectedPlayer.Character then
		setCharacterLocalTransparency(selectedPlayer.Character, 0)
	end
	Camera.CameraType = Enum.CameraType.Custom
	local myChar = LocalPlayer.Character
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
	if myHum then
		Camera.CameraSubject = myHum
	end
end

local function updateSpectateStatus()
	if isSpectating and selectedPlayer and selectedPlayer.Parent == Players then
		spectateBtn.Text = "Spectate: ON"
		spectateBtn.BackgroundColor3 = Color3.fromRGB(200, 55, 55)
		statusLabel.Text = "Mengamati: " .. selectedPlayer.DisplayName .. " (@" .. selectedPlayer.Name .. ")"
		if currentCamMode == 1 then
			setCharacterLocalTransparency(selectedPlayer.Character, 0)
			Camera.CameraType = Enum.CameraType.Custom
			local hum = selectedPlayer.Character and selectedPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then Camera.CameraSubject = hum end
		end
	else
		isSpectating = false
		resetToOwnCamera()
		spectateBtn.Text = "Spectate: OFF (Normal)"
		spectateBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
		if selectedPlayer then
			statusLabel.Text = "Target Aktif: @" .. selectedPlayer.Name .. " (Siap)"
		else
			statusLabel.Text = "Status: Normal"
		end
	end
end

