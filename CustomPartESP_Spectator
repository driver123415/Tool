	-- B. Update Kamera Spectate
	if isSpectating and selectedPlayer and selectedPlayer.Character then
		local char = selectedPlayer.Character
		local head = char:FindFirstChild("Head")
		local hrp = char:FindFirstChild("HumanoidRootPart")

		if currentCamMode == 2 and head then
			Camera.CameraType = Enum.CameraType.Scriptable
			setCharacterLocalTransparency(char, 1)
			Camera.CFrame = Camera.CFrame:Lerp(head.CFrame * CFrame.new(0, 0, -0.4), 0.35)
		elseif currentCamMode == 3 and hrp then
			Camera.CameraType = Enum.CameraType.Scriptable
			setCharacterLocalTransparency(char, 0)
			local lookCFrame = head and head.CFrame or hrp.CFrame
			local targetCFrame = CFrame.new(hrp.Position) * lookCFrame.Rotation * CFrame.new(0, 3, 8)
			Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.2)
		end
	end

	local viewportSize = Camera.ViewportSize
	local startPos = Vector2.new(viewportSize.X / 2, viewportSize.Y)

	-- C. Update Semua Pin Koordinat (Multi-Waypoints)
	for _, wp in ipairs(waypoints) do
		local showThisPin = coordEspEnabled and wp.visible
		local distToPin = (Camera.CFrame.Position - wp.position).Magnitude
		local dirText, dirArrow = getRelativeDirectionInfo(wp.position)

		-- Update info arah & jarak di dalam daftar GUI
		wp.rowDirLabel.Text = string.format("%s [%dm]", dirText, math.floor(distToPin))

		if wp.markerPart then
			wp.markerPart.Transparency = showThisPin and 0.35 or 1
		end
		if wp.highlight then
			wp.highlight.Enabled = showThisPin
		end
		if wp.billboard then
			wp.billboard.Enabled = showThisPin
		end

		if showThisPin then
			if wp.textLabel then
				wp.textLabel.Text = string.format("📍 %s %s [%d m]\n(%d, %d, %d)", wp.name, dirArrow, math.floor(distToPin), math.floor(wp.position.X), math.floor(wp.position.Y), math.floor(wp.position.Z))
			end

			local screenPos, onScreen = Camera:WorldToViewportPoint(wp.position)
			if onScreen and screenPos.Z > 0 then
				local endPos = Vector2.new(screenPos.X, screenPos.Y)
				local midPoint = (startPos + endPos) / 2
				local length = (endPos - startPos).Magnitude
				local angle = math.deg(math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X))

				wp.lineFrame.Position = UDim2.fromOffset(midPoint.X, midPoint.Y)
				wp.lineFrame.Size = UDim2.fromOffset(length, 2)
				wp.lineFrame.Rotation = angle
				wp.lineFrame.Visible = true
			else
				wp.lineFrame.Visible = false
			end
		else
			if wp.lineFrame then
				wp.lineFrame.Visible = false
			end
		end
	end

	-- D. Update ESP Benda / Player & Filter Jarak
	local totalCount = 0
	local visibleCount = 0

	for obj, data in pairs(trackedObjects) do
		if not obj or not obj.Parent or not data.targetPart or not data.targetPart.Parent then
			removeESP(obj)
			continue
		end

		totalCount += 1
		local worldPos = data.targetPart.Position
		local dist = (Camera.CFrame.Position - worldPos).Magnitude
		local inRange = (dist <= maxEspDistance)

		if inRange then
			visibleCount += 1
		end

		local showBox = espEnabled and inRange
		data.highlight.Enabled = showBox
		data.billboard.Enabled = showBox

		if showBox then
			if data.player then
				data.textLabel.Text = string.format("👤 %s [%d m]\n(%d, %d, %d)", data.player.DisplayName, math.floor(dist), math.floor(worldPos.X), math.floor(worldPos.Y), math.floor(worldPos.Z))
			else
				data.textLabel.Text = string.format("🎯 %s [%d m]", targetKeyword, math.floor(dist))
			end
		end

		if lineEnabled and inRange then
			local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
			if onScreen and screenPos.Z > 0 then
				local endPos = Vector2.new(screenPos.X, screenPos.Y)
				local midPoint = (startPos + endPos) / 2
				local length = (endPos - startPos).Magnitude
				local angle = math.deg(math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X))

				data.lineFrame.Position = UDim2.fromOffset(midPoint.X, midPoint.Y)
				data.lineFrame.Size = UDim2.fromOffset(length, 1.5)
				data.lineFrame.Rotation = angle
				data.lineFrame.Visible = true
			else
				data.lineFrame.Visible = false
			end
		else
			data.lineFrame.Visible = false
		end
	end

	countLabel.Text = string.format("Terdeteksi (%s): %d Terlihat / %d Total", targetKeyword, visibleCount, totalCount)
end))

-- ==========================================
-- 11. DROPDOWN & INTERAKSI TOMBOL
-- ==========================================
local function refreshDropdown()
	for _, child in ipairs(dropdownList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local otherPlayers = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			table.insert(otherPlayers, plr)
		end
	end

	if #otherPlayers == 0 then
		local emptyBtn = Instance.new("TextButton")
		emptyBtn.Size = UDim2.new(1, 0, 0, 28)
		emptyBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
		emptyBtn.Text = "Tidak ada player lain di server"
		emptyBtn.TextColor3 = Color3.fromRGB(160, 160, 160)
		emptyBtn.Font = Enum.Font.Gotham
		emptyBtn.TextSize = 11
		emptyBtn.ZIndex = 11
		emptyBtn.Parent = dropdownList
		dropdownList.CanvasSize = UDim2.fromOffset(0, 30)
		return
	end

	for _, plr in ipairs(otherPlayers) do
		local itemBtn = Instance.new("TextButton")
		itemBtn.Size = UDim2.new(1, 0, 0, 28)
		itemBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
		itemBtn.Text = "  " .. plr.DisplayName .. " (@" .. plr.Name .. ")"
		itemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		itemBtn.Font = Enum.Font.GothamSemibold
		itemBtn.TextSize = 11
		itemBtn.TextXAlignment = Enum.TextXAlignment.Left
		itemBtn.TextTruncate = Enum.TextTruncate.AtEnd
		itemBtn.ZIndex = 11
		itemBtn.Parent = dropdownList

		itemBtn.MouseButton1Click:Connect(function()
			if selectedPlayer and selectedPlayer.Character then
				setCharacterLocalTransparency(selectedPlayer.Character, 0)
			end
			selectedPlayer = plr
			lastEspPlayer = plr
			dropdownBtn.Text = "Target: " .. plr.DisplayName .. " ▼"
			dropdownList.Visible = false
			isSpectating = true
			updateSpectateStatus()
		end)
	end

	dropdownList.CanvasSize = UDim2.fromOffset(0, #otherPlayers * 30)
end

espBtn.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	espBtn.Text = espEnabled and "ESP Box: ON" or "ESP Box: OFF"
	espBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(40, 150, 80) or Color3.fromRGB(70, 70, 85)
end)

lineBtn.MouseButton1Click:Connect(function()
	lineEnabled = not lineEnabled
	lineBtn.Text = lineEnabled and "ESP Line: ON" or "ESP Line: OFF"
	lineBtn.BackgroundColor3 = lineEnabled and Color3.fromRGB(40, 150, 80) or Color3.fromRGB(70, 70, 85)
end)

dropdownBtn.MouseButton1Click:Connect(function()
	dropdownList.Visible = not dropdownList.Visible
	if dropdownList.Visible then
		refreshDropdown()
	end
end)

camModeBtn.MouseButton1Click:Connect(function()
	currentCamMode += 1
	if currentCamMode > #camModes then
		currentCamMode = 1
	end
	camModeBtn.Text = "Cam Mode: " .. camModes[currentCamMode]
	if isSpectating then
		updateSpectateStatus()
	end
end)

spectateBtn.MouseButton1Click:Connect(function()
	if not selectedPlayer then
		statusLabel.Text = "Pilih player di dropdown atau klik tubuhnya dulu!"
		return
	end
	isSpectating = not isSpectating
	updateSpectateStatus()
end)

table.insert(connections, Players.PlayerRemoving:Connect(function(plr)
	if plr == selectedPlayer then
		selectedPlayer = nil
		dropdownBtn.Text = "Pilih Player (Dropdown) ▼"
		isSpectating = false
		updateSpectateStatus()
	end
	if dropdownList.Visible then
		refreshDropdown()
	end
end))

table.insert(connections, Players.PlayerAdded:Connect(function()
	if dropdownList.Visible then
		refreshDropdown()
	end
end))

-- ==========================================
-- 12. FUNGSI CLOSE TOTAL [X]
-- ==========================================
closeBtn.MouseButton1Click:Connect(function()
	for _, conn in ipairs(connections) do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(connections)

	clearAllESP()
	clearAllWaypoints()
	if waypointFolder then waypointFolder:Destroy() end
	isSpectating = false
	resetToOwnCamera()
	screenGui:Destroy()
end)
