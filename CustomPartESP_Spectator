local function getPlayerFromInstance(inst)
	if not inst then return nil end
	local current = inst
	while current and current ~= workspace do
		if current:IsA("Model") then
			local plr = Players:GetPlayerFromCharacter(current)
			if plr then return plr, current end
		end
		current = current.Parent
	end
	return nil, nil
end

local function extractCleanKeyword(rawName)
	local cleaned = rawName:gsub("[_%-%s]*%d+[_%-%d]*$", "")
	if #cleaned < 2 then
		cleaned = rawName
	end
	return cleaned
end

local function resolveClickedObject(hitPart)
	if not hitPart then return nil, nil end

	local hitPlayer, charModel = getPlayerFromInstance(hitPart)
	if hitPlayer then
		if hitPlayer == LocalPlayer then return nil, nil end
		return charModel, hitPlayer
	end

	local candidate = hitPart
	local current = hitPart

	while current.Parent and current.Parent ~= workspace do
		local parent = current.Parent
		if parent:IsA("Model") then
			local ok, _, boxSize = pcall(function()
				return parent:GetBoundingBox()
			end)
			if ok and boxSize.Magnitude <= 38 then
				candidate = parent
				current = parent
			else
				break
			end
		else
			break
		end
	end

	return candidate, nil
end

local function getTargetPart(obj)
	if obj:IsA("BasePart") then
		return obj
	elseif obj:IsA("Model") then
		return obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function removeESP(obj)
	local data = trackedObjects[obj]
	if data then
		if data.highlight then data.highlight:Destroy() end
		if data.billboard then data.billboard:Destroy() end
		if data.lineFrame then data.lineFrame:Destroy() end
		trackedObjects[obj] = nil
	end
end

local function clearAllESP()
	for obj, _ in pairs(trackedObjects) do
		removeESP(obj)
	end
	table.clear(trackedObjects)
end

local function isMatchingTarget(obj)
	if not obj or obj == workspace or obj:IsDescendantOf(waypointFolder) then return false end
	if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
	if LocalPlayer.Character and (obj == LocalPlayer.Character or obj:IsDescendantOf(LocalPlayer.Character)) then
		return false
	end

	if obj.Parent and trackedObjects[obj.Parent] then
		return false
	end

	if targetMatchMode == "Player" then
		local plr = Players:GetPlayerFromCharacter(obj)
		if plr and plr ~= LocalPlayer then
			if targetKeyword == "AllPlayers" or plr.Name:lower():find(targetKeyword:lower(), 1, true) or plr.DisplayName:lower():find(targetKeyword:lower(), 1, true) then
				return true
			end
		end
		return false

	elseif targetMatchMode == "Name" then
		if #targetKeyword == 0 then return false end
		local lowerName = obj.Name:lower()
		local lowerKey = targetKeyword:lower()

		local plr = Players:GetPlayerFromCharacter(obj)
		if plr and plr ~= LocalPlayer then
			if lowerName:find(lowerKey, 1, true) or plr.DisplayName:lower():find(lowerKey, 1, true) then
				return true
			end
		end

		if string.find(lowerName, lowerKey, 1, true) then
			if obj:IsA("Model") and not plr then
				local ok, _, boxSize = pcall(function() return obj:GetBoundingBox() end)
				if ok and boxSize.Magnitude > 45 then
					return false
				end
			end
			if obj.Parent and obj.Parent ~= workspace and string.find(obj.Parent.Name:lower(), lowerKey, 1, true) then
				return false
			end
			return true
		end

	elseif targetMatchMode == "MeshId" and targetMeshId then
		if obj:IsA("MeshPart") and obj.MeshId == targetMeshId then
			return true
		end

	elseif targetMatchMode == "Size" and targetRefSize then
		if obj:IsA("BasePart") and (obj.Size - targetRefSize).Magnitude <= 0.25 then
			return true
		end
	end

	return false
end

local function addESP(obj)
	if trackedObjects[obj] then return end
	local targetPart = getTargetPart(obj)
	if not targetPart then return end

	local plr = Players:GetPlayerFromCharacter(obj)
	if plr then
		lastEspPlayer = plr
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "UniversalESPHighlight"
	highlight.Adornee = obj
	highlight.FillColor = plr and Color3.fromRGB(255, 65, 65) or Color3.fromRGB(255, 130, 0)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.4
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Enabled = espEnabled
	highlight.Parent = obj

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "UniversalESPBillboard"
	billboard.Adornee = targetPart
	billboard.Size = UDim2.fromOffset(150, 34)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = espEnabled
	billboard.Parent = obj

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.fromScale(1, 1)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = "🎯 " .. (plr and plr.DisplayName or targetKeyword)
	textLabel.TextColor3 = plr and Color3.fromRGB(255, 110, 110) or Color3.fromRGB(255, 185, 50)
	textLabel.TextStrokeTransparency = 0
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextSize = 12
	textLabel.Parent = billboard

	local lineFrame = Instance.new("Frame")
	lineFrame.Name = "TracerLine"
	lineFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	lineFrame.BackgroundColor3 = plr and Color3.fromRGB(255, 75, 75) or Color3.fromRGB(255, 140, 0)
	lineFrame.BorderSizePixel = 0
	lineFrame.Visible = false
	lineFrame.Parent = lineContainer

	trackedObjects[obj] = {
		highlight = highlight,
		billboard = billboard,
		textLabel = textLabel,
		lineFrame = lineFrame,
		targetPart = targetPart,
		player = plr
	}
end

local function checkObject(obj)
	if isMatchingTarget(obj) then
		task.defer(function()
			if isMatchingTarget(obj) then
				addESP(obj)
			end
		end)
	end
end

local function rescanWorkspace()
	clearAllESP()
	for _, obj in ipairs(workspace:GetDescendants()) do
		checkObject(obj)
	end
end

rescanWorkspace()

