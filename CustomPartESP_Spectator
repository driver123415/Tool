-- A. Tambah Pin dari posisi Target Player / Benda ESP
addTargetPinBtn.MouseButton1Click:Connect(function()
	local targetPlr = selectedPlayer or lastEspPlayer
	if not targetPlr then
		for _, data in pairs(trackedObjects) do
			if data.player then
				targetPlr = data.player
				break
			end
		end
	end

	if targetPlr and targetPlr.Character then
		local hrp = getTargetPart(targetPlr.Character)
		if hrp then
			addWaypointPin(hrp.Position, "@" .. targetPlr.DisplayName)
			return
		end
	end

	-- Fallback ke benda ESP terdekat jika belum memilih player
	local closestPos = nil
	local closestDist = math.huge
	for _, data in pairs(trackedObjects) do
		if data.targetPart and data.targetPart.Parent then
			local d = (Camera.CFrame.Position - data.targetPart.Position).Magnitude
			if d < closestDist then
				closestDist = d
				closestPos = data.targetPart.Position
			end
		end
	end

	if closestPos then
		addWaypointPin(closestPos, targetKeyword .. " #" .. tostring(waypointCounter + 1))
	else
		statusLabel.Text = "Pilih player atau ESP benda dulu untuk di-pin!"
	end
end)

